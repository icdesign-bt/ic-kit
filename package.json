{
  "name": "ic-kit",
  "version": "0.1.0",
  "description": "UI Kit из KURS v2 Design System",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icdesign-bt/ic-kit.git"
  },
  "bugs": {
    "url": "https://github.com/icdesign-bt/ic-kit/issues"
  },
  "homepage": "https://icdesign-bt.github.io/ic-kit/",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/ic-kit.js",
  "module": "./dist/ic-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ic-kit.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/ic-kit.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepare": "npm run build",
    "build:storybook": "STORYBOOK=1 storybook build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview",
    "tokens:build": "node scripts/build-tokens.mjs",
    "typography:build": "node scripts/build-typography.mjs",
    "icons:parse": "node scripts/parse-icon-metadata.mjs",
    "icons:sync": "node scripts/sync-icons-from-figma.mjs",
    "icons:reexport": "node scripts/export-icons-via-figma-desktop-mcp.mjs --force",
    "icons:audit": "node scripts/audit-icon-archive-mapping.mjs",
    "icons:import": "node scripts/import-icons-archive.mjs",
    "icons:manifest": "node scripts/build-icons-manifest.mjs",
    "prebuild": "npm run tokens:build && npm run typography:build && npm run icons:manifest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-toolbars": "^8.6.18",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^8.6.14",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
